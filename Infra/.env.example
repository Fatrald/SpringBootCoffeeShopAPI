# =====================================================================
# Template environment untuk docker-compose.yml
#
# 1. Salin:   cp .env.example .env
# 2. Ganti setiap "[placeholder]" dengan password acak
# 3. JANGAN commit file .env ke Git
# =====================================================================

# --- PostgreSQL (superuser, hanya untuk administrasi) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=[placeholder]

# --- Password user database per service ---
KEYCLOAK_DB_PASSWORD=[placeholder]
MENU_DB_PASSWORD=[placeholder]
ORDER_DB_PASSWORD=[placeholder]
PREPARATION_DB_PASSWORD=[placeholder]
NOTIFICATION_DB_PASSWORD=[placeholder]

# --- Redis ---
REDIS_PASSWORD=[placeholder]

# --- RabbitMQ (user admin, untuk UI management) ---
RABBITMQ_USER=coffeeshop
RABBITMQ_PASSWORD=[placeholder]

# --- Keycloak (admin console) ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=[placeholder]
